{{- /*
  What every chart reads: the environment's values, with the image names and namespaces from helm/env.sh, and the
  services' addresses in the cluster. The charts never read an environment file themselves.
*/}}
{{- $values := .Values | toYaml | fromYaml }}
{{- if not (hasKey $values "secrets") }}
{{- fail (printf "The secrets file %s doesn't exist. Copy environment/secrets.yaml.example to environment/secrets.yaml and fill it in, or set DATASPACE_SECRETS_FILE to its path." (env "DATASPACE_SECRETS_FILE" | default "environment/secrets.yaml")) }}
{{- end }}
{{- $namespace := requiredEnv "NAMESPACE" }}
{{- $images := index $values "images" | default dict }}
{{- /* As env.sh and scripts/build-images.sh: unset means the default, and empty means no registry prefix. */}}
{{- $_ := set $images "registry" (exec "sh" (list "-c" "printf %s \"${LOCAL_REGISTRY-k3d-iff.localhost:12345}\"")) }}
{{- $_ := set $images "repo" (requiredEnv "MAIN_REPO") }}
{{- $_ := set $images "version" (requiredEnv "MAIN_VERSION") }}
{{- $_ := set $values "images" $images }}
{{- $_ := set $values "namespaces" (dict "services" $namespace "participants" (requiredEnv "PARTICIPANTS_NAMESPACE")) }}
{{- $_ := set $values "addresses" (dict
      "registry" (printf "http://registry.%s:19000" $namespace)
      "gateway" (printf "http://gateway.%s:8080" $namespace)
      "dspGateway" (printf "http://dsp-gateway.%s:8085" $namespace)) }}
{{- /* The Ingress has to admit the larger limit, and each service enforces its own. */}}
{{- if lt (int64 $values.limits.maxUploadBytes) (int64 $values.limits.maxJsonBytes) }}
{{- fail "limits.maxUploadBytes must not be below limits.maxJsonBytes" }}
{{- end }}
{{ toYaml $values }}
