# Settings for scripts/build-images.sh. Copy this file to scripts/build-images.env, which git ignores,
# and change what you need. A variable set in the shell takes precedence over this file.
# The file is read as KEY=value lines and never run, so nothing in a value is expanded.

# The registry the cluster pulls from. Pushing needs one.
REGISTRY=k3d-iff.localhost:12345
# The repository, the chart's images.repo.
REPO=dataspace
# The tag, the chart's images.version.
VERSION=latest
