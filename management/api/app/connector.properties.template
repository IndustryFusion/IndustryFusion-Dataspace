# Template for /config/connector.properties. Whatever provisions a connector
# replaces ${PARTICIPANT_ID}, ${CONNECTOR_URL}, ${DSP_ADDRESS} and ${PUBLIC_ADDRESS}.
# The last two are what other connectors use, through the DSP gateway if this
# connector is reached from outside. The API key and database
# connection come from EDC_API_AUTH_KEY and EDC_DATASOURCE_DEFAULT_*.

edc.participant.id=${PARTICIPANT_ID}
edc.hostname=${CONNECTOR_URL}

web.http.port=8080
web.http.path=/api
web.http.management.port=8081
web.http.management.path=/management
web.http.protocol.port=8082
web.http.protocol.path=/api/v1/dsp
web.http.control.port=8083
web.http.control.path=/control
web.http.public.port=8084
web.http.public.path=/api/v1/public

# What other participants and this connector's own data plane use to reach it
edc.dsp.callback.address=${DSP_ADDRESS}
edc.control.endpoint=${CONNECTOR_URL}:8083/control
edc.dataplane.api.public.baseurl=${PUBLIC_ADDRESS}/v2

edc.transfer.proxy.token.signer.privatekey.alias=data-plane-signing-key
edc.transfer.proxy.token.verifier.publickey.alias=data-plane-verification-key

edc.sql.schema.autocreate=true
